// 最小の標準ライブラリ（iris 自身で記述）。
// 各プログラムの先頭に自動で前置される。
// 現状のコード生成は i32 / bool / string（NUL 終端）に対応する範囲で書く。

// 1 文字（i32 の LSB）を stdout へ書き出す。write syscall（nr=1, fd=1, buf=&c, len=1）。
// x86-64 リトルエンディアンでは &c の指すバイトが LSB = ASCII 値（libc 不要）。
fn putchar(c: i32): i32 {
    syscall3(1, 1 as i64, &c as i64, 1)
    return c
}

// NUL 終端文字列を stdout へ書き出し、末尾に改行を付ける。write syscall（nr=1, fd=1）。
fn puts(s: string): i32 {
    let n = strlen(s) as i64
    syscall3(1, 1 as i64, s as i64, n)
    syscall3(1, 1 as i64, "\n" as i64, 1)
    return n as i32
}

// NUL 終端文字列の長さ（バイト数）。libc 非依存の iris 実装。
fn strlen(s: string): i32 {
    let mut i = 0
    while s[i] as i32 != 0 {
        i = i + 1
    }
    return i
}

// NUL 終端文字列を辞書順比較。等しければ 0、a<b で負、a>b で正（libc strcmp 互換）。
// match の文字列パターン比較（codegen:2427 の call @strcmp）はこの定義に解決される。
fn strcmp(a: string, b: string): i32 {
    let mut i = 0
    while a[i] as i32 != 0 {
        if a[i] as i32 != b[i] as i32 {
            return a[i] as i32 - b[i] as i32
        }
        i = i + 1
    }
    return 0 - (b[i] as i32)
}

// 最大 n バイトまで NUL 終端文字列を辞書順比較（libc strncmp 互換）。
fn strncmp(a: string, b: string, n: i64): i32 {
    let limit = n as i32
    let mut i = 0
    while i < limit {
        if a[i] as i32 != b[i] as i32 {
            return a[i] as i32 - b[i] as i32
        }
        if a[i] as i32 == 0 {
            return 0
        }
        i = i + 1
    }
    return 0
}
extern fn malloc(n: i64): RawPtr
extern fn free(p: RawPtr): void
extern fn memset(ptr: RawPtr, val: i32, n: i64): RawPtr
extern fn strcpy(dst: string, src: string): string
extern fn strcat(dst: string, src: string): string

// 文字列の固有メソッド。所有権上は `&self`（共有借用）で受け、受け手を消費しない。
impl string {
    // 文字列の長さ（NUL を除くバイト数）。
    fn len(&self): i32 {
        return strlen(self)
    }

    // 自身と other を連結した新しい文字列を返す。結果はヒープ（malloc）に確保する
    // （Vec と同様にリークを許容する）。
    fn concat(&self, other: string): string {
        let n = strlen(self) + strlen(other) + 1
        let buf = malloc(n as i64) as string
        let a = strcpy(buf, self)
        let b = strcat(buf, other)
        return buf
    }
}

// イテレータ（ADR-0007）。next() で次の要素を Some で返し、終端で None を返す。
// `for x in it { ... }` はこのトレイトの実装を要求し、next() を回して要素を束縛する。
trait Iterator<T> {
    fn next(&mut self): Option<T>
}

// 1 桁の数字 (0-9) を出力する。
fn put_digit(d: i32): i32 {
    return putchar(d + 48)
}

// 改行を出力する。
fn newline(): i32 {
    return putchar(10)
}

// 整数を 10 進で出力する（負数・多桁は再帰で処理）。
fn print_int(n: i32): i32 {
    if n < 0 {
        let neg = putchar(45)
        return print_int(0 - n)
    }
    if n >= 10 {
        let hi = print_int(n / 10)
    }
    return put_digit(n % 10)
}

// 整数を出力して改行する。
fn println_int(n: i32): i32 {
    let r = print_int(n)
    return newline()
}

// bool を 1 / 0 で出力して改行する。
fn println_bool(b: bool): i32 {
    return println_int(b ? 1 : 0)
}
