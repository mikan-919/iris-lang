// 最小の標準ライブラリ（iris 自身で記述）。
// 各プログラムの先頭に自動で前置される。I/O は C の putchar / puts を extern で借りる。
// 現状のコード生成は i32 / bool / string（NUL 終端）に対応する範囲で書く。

// C の putchar（1 文字出力）。返り値は書き込んだ文字。
extern fn putchar(c: i32): i32

// C の puts（NUL 終端文字列を出力し、末尾に改行を付ける）。返り値は非負なら成功。
extern fn puts(s: string): i32

// C の strcmp（NUL 終端文字列を比較。等しければ 0）。match の文字列パターン比較に使う。
extern fn strcmp(a: string, b: string): i32

// C の文字列操作を借りる。strlen は長さ、malloc はバッファ確保、strcpy/strcat は連結に使う。
// （malloc は size_t を取るが、x86-64 では i32 引数も edi 経由で rdi へゼロ拡張されるため安全。）
extern fn strlen(s: string): i32
extern fn malloc(n: i32): string
extern fn strcpy(dst: string, src: string): string
extern fn strcat(dst: string, src: string): string

// 文字列の固有メソッド。所有権上は `&self`（共有借用）で受け、受け手を消費しない。
impl string {
    // 文字列の長さ（NUL を除くバイト数）。
    fn len(&self): i32 {
        return strlen(self)
    }

    // 自身と other を連結した新しい文字列を返す。結果はヒープ（malloc）に確保する
    // （現状 free は無く、Vec と同様にリークを許容する）。
    fn concat(&self, other: string): string {
        let n = strlen(self) + strlen(other) + 1
        let buf = malloc(n)
        let a = strcpy(buf, self)
        let b = strcat(buf, other)
        return buf
    }
}

// イテレータ（ADR-0007）。next() で次の要素を Some で返し、終端で None を返す。
// `for x in it { ... }` はこのトレイトの実装を要求し、next() を回して要素を束縛する。
trait Iterator<T> {
    fn next(&mut self): Option<T>
}

// 1 桁の数字 (0-9) を出力する。
fn put_digit(d: i32): i32 {
    return putchar(d + 48)
}

// 改行を出力する。
fn newline(): i32 {
    return putchar(10)
}

// 整数を 10 進で出力する（負数・多桁は再帰で処理）。
fn print_int(n: i32): i32 {
    if n < 0 {
        let neg = putchar(45)
        return print_int(0 - n)
    }
    if n >= 10 {
        let hi = print_int(n / 10)
    }
    return put_digit(n % 10)
}

// 整数を出力して改行する。
fn println_int(n: i32): i32 {
    let r = print_int(n)
    return newline()
}

// bool を 1 / 0 で出力して改行する。
fn println_bool(b: bool): i32 {
    return println_int(b ? 1 : 0)
}
